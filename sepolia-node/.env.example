# Copy to .env and fill in the values: cp .env.example .env

# Client versions (checked 2026-10-24: latest stable releases, both from 2026-10-23).
# Check https://github.com/ethereum/go-ethereum/releases and
# https://github.com/sigp/lighthouse/releases again before starting.
GETH_VERSION=v1.17.10
LIGHTHOUSE_VERSION=v8.3.2

# Where the chain data is stored. Must be on an SSD with ~650 GB+ free.
# Relative paths are relative to this folder.
DATA_DIR=./data

# Public IPv4 of the home connection (curl -4 https://api.ipify.org).
# Both clients advertise it to other peers so they can connect inbound.
PUBLIC_IP=203.0.113.10

# geth history retention: all | postmerge | postprague | postosaka
# postosaka keeps the least block history (Sepolia cutoff: block 9408577).
GETH_HISTORY_CHAIN=postosaka

GETH_MAXPEERS=50
LIGHTHOUSE_TARGET_PEERS=100

# Checkpoint sync provider for Lighthouse (checked 2026-10-24, responds)
CHECKPOINT_SYNC_URL=https://checkpoint-sync.sepolia.ethpandaops.io
